# Local game server database (created by start-server.sh)
good-game-database.*

# sbt build output. Only the optimized client the site loads is committed
# (sbt fullOptJS), so the server runs without building it; the server
# compiles good-game itself when it starts.
**/target/**
!haunt-roll-fail/target/**/
!haunt-roll-fail/target/scala-2.13/hrf-opt.js
!haunt-roll-fail/target/scala-2.13/hrf-opt.js.map
!haunt-roll-fail/target/scala-2.13/hrf-opt/main.js
!haunt-roll-fail/target/scala-2.13/hrf-opt/main.js.map

# https: certificate (holds the private key) and Let's Encrypt webroot (created by setup-https.sh)
good-game/certificate.pkcs12*
good-game/acme/

# Bug reports saved by the server, and its GitHub token for posting them
good-game/bug-reports/
good-game/github-token

# Games copy settings and the server's daily database copies (good-game/Backup.scala)
good-game/backup-dir
good-game/db-backups/
